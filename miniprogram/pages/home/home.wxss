.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #eaf2ff 0%, #f7f8fa 440rpx);
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: linear-gradient(135deg, #1989fa, #0066ff);
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.nav-right {
  position: absolute;
  right: 32rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}

.nav-link {
  color: #fff;
  font-size: 28rpx;
}

.body {
  box-sizing: border-box;
}

.search-wrapper {
  padding: 16rpx 24rpx;
}

.search-fake {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 36rpx;
  color: #1989fa;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #c8c9cc;
}

.hero-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 8rpx;
  color: #323233;
}

.hero-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #707070;
}

.hero-notice {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #969799;
  background: #f5f7fa;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.hero-button {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff9f43, #ff6b6b);
  border-radius: 999rpx;
  border: none;
}

.hero-button::after {
  border: none;
}

.banner-wrapper {
  padding: 0 24rpx;
  margin: 24rpx 0;
}

.banner {
  height: 300rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.feature-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
}

.feature-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-text {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
}

.feature-text {
  font-size: 24rpx;
  color: #323233;
  margin-top: 8rpx;
  text-align: center;
}

.products-section {
  margin-top: 20rpx;
  padding-top: 8rpx;
}

.filter-bar {
  display: flex;
  align-items: stretch;
  margin: 0 24rpx;
  background: #f7f9fc;
  border-radius: 16rpx;
  border: 1rpx solid #e8ecf2;
  box-shadow: 0 4rpx 20rpx rgba(31, 56, 88, 0.06);
  overflow: hidden;
  position: sticky;
  top: 0;
  z-index: 50;
}

.filter-pick {
  flex: 1;
  min-width: 0;
}

.filter-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
}

.filter-cell:active {
  background: rgba(25, 137, 250, 0.06);
}

.filter-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  max-width: calc(100% - 28rpx);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-cell--on .filter-label {
  color: #1989fa;
}

.filter-caret {
  flex-shrink: 0;
  margin-left: 6rpx;
  font-size: 16rpx;
  color: #969799;
  line-height: 1;
  transform: scale(0.85);
}

.filter-cell--on .filter-caret {
  color: #1989fa;
}

.filter-vsep {
  width: 1rpx;
  align-self: stretch;
  margin: 20rpx 0;
  background: linear-gradient(180deg, transparent 0%, #dce1e8 20%, #dce1e8 80%, transparent 100%);
  flex-shrink: 0;
}

.products-grid {
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.empty-state {
  padding: 72rpx 32rpx 48rpx;
  text-align: center;
  color: #646566;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.empty-btn {
  font-size: 26rpx;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #1989fa 0%, #3d9eff 100%);
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.28);
}

.empty-btn::after {
  border: none;
}

.list-status {
  text-align: center;
  font-size: 24rpx;
  color: #969799;
  padding: 24rpx;
}

.bottom-space {
  height: 24rpx;
}
