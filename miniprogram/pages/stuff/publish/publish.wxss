.page {
  min-height: 100vh;
  background: #f8f9fa;
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #ecf5ff;
  border: 1rpx solid #d9ecff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  color: #1989fa;
  font-size: 28rpx;
}

.notice-txt {
  flex: 1;
  font-size: 26rpx;
  color: #1989fa;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.sec-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 20rpx;
}

.sub {
  font-size: 24rpx;
  color: #969799;
  font-weight: normal;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f2f3f5;
}

.thumb--load {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #969799;
}

.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #c8c9cc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
}

.img-add-plus {
  font-size: 56rpx;
  color: #969799;
  line-height: 1;
}

.img-add-txt {
  font-size: 22rpx;
  color: #969799;
  margin-top: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.field:last-child {
  border-bottom: none;
}

.field.col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.field.pick {
  justify-content: space-between;
}

.flab {
  width: 200rpx;
  flex-shrink: 0;
  color: #323233;
}

.field.col .flab {
  width: auto;
}

.finp {
  flex: 1;
  text-align: right;
}

.fph {
  flex: 1;
  text-align: right;
  color: #323233;
}

.fta {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}

.bottom-submit {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #29e075, #14dd89);
  border-radius: 999rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}
