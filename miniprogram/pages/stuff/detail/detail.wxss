.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.state {
  padding: 80rpx;
  text-align: center;
  color: #969799;
  font-size: 28rpx;
}

.swipe-wrap {
  background: #fff;
}

.item-swiper {
  height: 600rpx;
  width: 100%;
}

.swiper-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.info-group .status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 16rpx;
}

.item-status {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.item-status.active {
  background: #e8fff3;
  color: #07c160;
}

.item-status.auditing {
  background: #fff7e8;
  color: #ff976a;
}

.item-status.inactive {
  background: #fef0f0;
  color: #ee0a24;
}

.item-id {
  font-size: 26rpx;
  color: #969799;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #323233;
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.tag-p {
  background: #ecf5ff;
  color: #1989fa;
}

.tag-s {
  background: #e8f9e8;
  color: #07c160;
}

.tag-w {
  background: #fff7e6;
  color: #ff976a;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.cell {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.cell:last-child {
  border-bottom: none;
}

.cell-lab {
  width: 200rpx;
  flex-shrink: 0;
  color: #969799;
}

.cell-val {
  flex: 1;
  color: #323233;
  word-break: break-all;
}

.cell-act {
  color: #1989fa;
  margin-left: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  white-space: pre-wrap;
}

.stats-card .stats {
  display: flex;
  gap: 48rpx;
}

.stat-i {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-n {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.stat-t {
  font-size: 22rpx;
  color: #969799;
  margin-top: 4rpx;
}

.bottom-spacer {
  height: 24rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  width: 100%;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(90deg, #1989fa, #39a0ff);
  border-radius: 999rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.btn-plain {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #1989fa;
  background: #fff;
  border: 1rpx solid #1989fa;
  border-radius: 999rpx;
}

.btn-plain::after {
  border: none;
}

.flex1 {
  flex: 1;
}

.popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
}

.popup-bottom {
  align-items: flex-end;
}

.popup-center {
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.sheet {
  width: 100%;
  max-height: 78vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-x {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 44rpx;
  color: #c8c9cc;
  padding: 8rpx 16rpx;
}

.sheet-scroll {
  max-height: 56vh;
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.form-row.col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.pick-row {
  justify-content: space-between;
}

.flab {
  width: 180rpx;
  flex-shrink: 0;
  color: #646566;
}

.fval {
  flex: 1;
  text-align: right;
  color: #323233;
}

.finp {
  flex: 1;
  text-align: right;
}

.fta {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
}

.row-map {
  justify-content: space-between;
}

.btn-mini {
  margin: 0;
}

.hint {
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
  padding: 16rpx 0;
}

.sheet-submit {
  width: 100%;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  background: #1989fa;
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  border: none;
}

.sheet-submit::after {
  border: none;
}

.dialog {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.dialog-ta {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.dialog-btns {
  display: flex;
  gap: 24rpx;
}

.d-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.d-btn::after {
  border: none;
}

.d-cancel {
  background: #f2f3f5;
  color: #323233;
}

.d-ok {
  background: #1989fa;
  color: #fff;
}
