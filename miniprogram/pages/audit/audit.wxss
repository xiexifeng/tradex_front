.audit-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #ebedf0;
  border-top-color: #1989fa;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #969799;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 40rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.error-icon {
  font-size: 96rpx;
  line-height: 1;
  color: #ff4d4f;
}

.error-text {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
}

.retry-btn {
  min-width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(to right, #1989fa, #39a0ff);
  border-radius: 36rpx;
  padding: 0;
  margin: 0;
}

.retry-btn::after {
  border: none;
}

.empty-container {
  padding: 160rpx 48rpx;
  text-align: center;
}

.empty-desc {
  font-size: 28rpx;
  color: #969799;
}

.audit-content {
  padding-bottom: 48rpx;
}

.item-swipe {
  height: 600rpx;
  background: #fff;
}

.item-swipe--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-img-tip {
  font-size: 28rpx;
  color: #c8c9cc;
}

.swipe-img {
  width: 100%;
  height: 100%;
  display: block;
}

.info-card,
.audit-card {
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  border-bottom: 1px solid #f5f5f5;
}

.section-icon {
  font-size: 36rpx;
  color: #1989fa;
}

.item-info {
  padding: 0 32rpx 32rpx;
}

.item-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #323233;
  padding-top: 32rpx;
  line-height: 1.4;
}

.item-description {
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.item-tags {
  display: flex;
  gap: 16rpx;
  padding-bottom: 24rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.tag-primary {
  color: #1989fa;
  background: rgba(25, 137, 250, 0.1);
  border: 1px solid rgba(25, 137, 250, 0.35);
}

.tag-success {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  border: 1px solid rgba(7, 193, 96, 0.35);
}

.item-meta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f5f5f5;
}

.meta-item {
  display: flex;
  align-items: flex-start;
  min-height: 64rpx;
}

.meta-label {
  font-size: 28rpx;
  color: #969799;
  width: 8em;
  flex-shrink: 0;
}

.meta-value {
  font-size: 28rpx;
  color: #323233;
  flex: 1;
  min-width: 0;
}

.audit-form {
  padding: 0 32rpx 32rpx;
}

.field-label {
  font-size: 28rpx;
  color: #323233;
  margin-bottom: 16rpx;
}

.remark-area {
  width: 100%;
  min-height: 176rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f7f8fa;
  border-radius: 16rpx;
  border: 1px solid #ebedf0;
  box-sizing: border-box;
}

.audit-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  padding: 0;
  margin: 0;
  color: #fff;
}

.action-btn::after {
  border: none;
}

.reject-btn {
  background: #ff4d4f;
}

.approve-btn {
  background: linear-gradient(to right, #1989fa, #39a0ff);
}

.audit-result {
  padding: 0 32rpx 32rpx;
}

.result-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.result-status.status-pass {
  background: #f6ffed;
}

.result-status.status-pass .result-icon,
.result-status.status-pass .result-title {
  color: #52c41a;
}

.result-status.status-reject {
  background: #fff2f0;
}

.result-status.status-reject .result-icon,
.result-status.status-reject .result-title {
  color: #ff4d4f;
}

.result-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
}

.result-remark {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 24rpx 32rpx 0;
  background: #f7f8fa;
  border-radius: 16rpx;
  border-left: 8rpx solid #1989fa;
}

.remark-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
  width: 8em;
  flex-shrink: 0;
  line-height: 1.6;
}

.remark-value {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.7;
  flex: 1;
  min-width: 0;
  white-space: pre-wrap;
  word-break: break-word;
}
