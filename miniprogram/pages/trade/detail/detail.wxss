.trade-detail {
  min-height: 100vh;
  background: linear-gradient(180deg, #eaf2ff 0%, #f7f8fa 440rpx);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.loading {
  padding: 120rpx;
  text-align: center;
  font-size: 28rpx;
  color: #969799;
}

.detail-content {
  padding: 32rpx;
}

.notice-card {
  background: #ecf5ff;
  border: 1px solid #d9ecff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

.notice-content {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.notice-icon {
  font-size: 32rpx;
  color: #1989fa;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 28rpx;
  color: #1989fa;
  line-height: 40rpx;
}

.trade-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.status-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.trade-time {
  font-size: 24rpx;
  color: #969799;
}

.trade-status {
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.trade-status::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.trade-status.trading {
  color: #1989fa;
}

.trade-status.trading::before {
  background: #1989fa;
}

.trade-status.accepted {
  color: #07c160;
}

.trade-status.accepted::before {
  background: #07c160;
}

.trade-status.completed {
  color: #ff976a;
}

.trade-status.completed::before {
  background: #ff976a;
}

.trade-status.cancelled {
  color: #969799;
}

.trade-status.cancelled::before {
  background: #969799;
}

.trade-status.rejected {
  color: #ee0a24;
}

.trade-status.rejected::before {
  background: #ee0a24;
}

.trade-status.refunded {
  color: #7232dd;
}

.trade-status.refunded::before {
  background: #7232dd;
}

.trade-type {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.trade-type.sell {
  color: #ee0a24;
  background: rgba(238, 10, 36, 0.1);
}

.trade-type.buy {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.flow-card {
  margin-bottom: 32rpx;
  padding: 28rpx 32rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.flow-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.flow-subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #969799;
}

.flow-steps {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.flow-step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 12rpx 0;
  opacity: 0.65;
}

.flow-step--active {
  opacity: 1;
}

.flow-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #f2f6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #1989fa;
  flex-shrink: 0;
}

.flow-step-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 4rpx;
}

.flow-step-desc {
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.safety-tips {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1px solid #f5f5f5;
}

.tips-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.tip-row {
  font-size: 24rpx;
  color: #666;
  line-height: 40rpx;
  margin-bottom: 12rpx;
}

.info-group,
.trade-method-group,
.logistics-group,
.score-group {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #323233;
  padding: 32rpx;
  border-bottom: 1px solid #f5f5f5;
}

.section-icon {
  font-size: 36rpx;
  color: #1989fa;
}

.trade-content {
  display: flex;
  padding: 32rpx;
  background: #fafafa;
  border-radius: 16rpx;
  margin: 24rpx;
}

.trade-image {
  width: 240rpx;
  height: 240rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #eee;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 16rpx;
}

.item-meta,
.swap-meta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
}

.swap-info {
  padding: 32rpx;
}

.swap-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.swap-content {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
}

.swap-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #eee;
}

.swap-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.payment-info {
  padding: 32rpx;
}

.payment-amount {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  background: #fff7f7;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.payment-amount .label {
  font-size: 28rpx;
  color: #666;
}

.payment-amount .value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ee0a24;
}

.payment-detail .meta-item {
  margin-bottom: 12rpx;
}

.logistics-info {
  padding: 32rpx;
}

.address-item {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 8rpx;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.address-item .label {
  font-size: 26rpx;
  color: #1989fa;
  flex-shrink: 0;
}

.address-item .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.score-info {
  padding: 32rpx;
}

.score-item {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.score-item .label {
  font-size: 28rpx;
  color: #969799;
  flex-shrink: 0;
}

.rate-slider {
  flex: 1;
  min-width: 280rpx;
}

.score-value {
  font-size: 28rpx;
  color: #ff976a;
  font-weight: 500;
}

.action-buttons {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 24rpx;
  z-index: 99;
}

.abtn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 0;
  margin: 0;
}

.abtn::after {
  border: none;
}

.abtn-primary {
  background: linear-gradient(to right, #1989fa, #39a0ff);
  color: #fff;
}

.abtn-danger {
  background: #fff;
  color: #ee0a24;
  border: 1px solid #ee0a24;
}

.abtn-success {
  background: linear-gradient(to right, #07c160, #06ae56);
  color: #fff;
}
