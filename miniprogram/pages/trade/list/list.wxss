.trade-list {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.notice-card {
  background: #ecf5ff;
  border: 1px solid #d9ecff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin: 24rpx;
}

.notice-content {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.notice-icon {
  font-size: 32rpx;
  color: #1989fa;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 28rpx;
  color: #1989fa;
  line-height: 40rpx;
}

.status-info-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.status-info-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.status-info-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #555;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot.trading {
  background: #1989fa;
}

.status-dot.accepted {
  background: #07c160;
}

.status-dot.completed {
  background: #ff976a;
}

.status-dot.cancelled {
  background: #969799;
}

.status-dot.rejected {
  background: #ee0a24;
}

.tab-scroll {
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  white-space: nowrap;
  height: 100rpx;
}

.tab-inner {
  display: inline-flex;
  padding: 12rpx 24rpx 20rpx;
  gap: 8rpx;
}

.tab-item {
  flex-shrink: 0;
  min-width: 132rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
}

.tab-item--active {
  color: #1989fa;
  font-weight: 500;
  background: rgba(25, 137, 250, 0.08);
}

.trade-list-content {
  padding: 24rpx;
}

.trade-item {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.trade-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid #f5f5f5;
}

.trade-status {
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.trade-status::before {
  content: '';
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.trade-status.trading {
  color: #1989fa;
}

.trade-status.trading::before {
  background: #1989fa;
}

.trade-status.accepted {
  color: #07c160;
}

.trade-status.accepted::before {
  background: #07c160;
}

.trade-status.completed {
  color: #ff976a;
}

.trade-status.completed::before {
  background: #ff976a;
}

.trade-status.cancelled {
  color: #969799;
}

.trade-status.cancelled::before {
  background: #969799;
}

.trade-status.rejected {
  color: #ee0a24;
}

.trade-status.rejected::before {
  background: #ee0a24;
}

.trade-status.refunded {
  color: #7232dd;
}

.trade-status.refunded::before {
  background: #7232dd;
}

.trade-type {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.trade-type.sell {
  color: #ee0a24;
  background: rgba(238, 10, 36, 0.1);
}

.trade-type.buy {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.trade-content {
  display: flex;
  padding: 32rpx;
}

.trade-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f2f3f5;
}

.trade-info {
  flex: 1;
  min-width: 0;
}

.trade-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trade-id {
  font-size: 24rpx;
  color: #969799;
  margin-bottom: 16rpx;
}

.trade-price {
  margin-bottom: 24rpx;
}

.trade-price .label {
  font-size: 26rpx;
  color: #969799;
}

.trade-price .value {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: 500;
  margin-left: 8rpx;
}

.trade-score {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-item .label {
  font-size: 24rpx;
  color: #969799;
}

.score-text {
  font-size: 26rpx;
  color: #323233;
}

.trade-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1px solid #f5f5f5;
  justify-content: flex-end;
}

.btn {
  margin: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: rgba(25, 137, 250, 0.08);
  color: #1989fa;
  border: 1px solid #1989fa;
}

.btn-primary-solid {
  background: linear-gradient(to right, #1989fa, #39a0ff);
  color: #fff;
}

.btn-danger {
  background: rgba(238, 10, 36, 0.08);
  color: #ee0a24;
  border: 1px solid #ee0a24;
}

.btn-success {
  background: linear-gradient(to right, #07c160, #06ae56);
  color: #fff;
}

.list-foot {
  text-align: center;
  font-size: 26rpx;
  color: #969799;
  padding: 32rpx 0;
}

.list-foot.empty {
  padding: 80rpx 0;
}
