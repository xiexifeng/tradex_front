.notification-detail {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #ebedf0;
  border-top-color: #1989fa;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #969799;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 40rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.error-icon {
  font-size: 96rpx;
  color: #ff4d4f;
  line-height: 1;
}

.error-text {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
}

.retry-btn {
  min-width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #1989fa 0%, #39a0ff 100%);
  border-radius: 36rpx;
  padding: 0;
  margin: 0;
}

.retry-btn::after {
  border: none;
}

.empty-container {
  padding: 160rpx 48rpx;
  text-align: center;
}

.empty-desc {
  font-size: 28rpx;
  color: #969799;
}

.detail-card {
  margin: 28rpx;
  padding: 44rpx 40rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.detail-header {
  margin-bottom: 36rpx;
  padding-bottom: 32rpx;
  border-bottom: 1px solid #ebedf0;
}

.title {
  margin-bottom: 28rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.4;
}

.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.tag-primary {
  color: #1989fa;
  background: rgba(25, 137, 250, 0.1);
}

.tag-success {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.tag-info {
  color: #646566;
  background: #f2f3f5;
}

.tag-danger {
  color: #ee0a24;
  background: rgba(238, 10, 36, 0.08);
}

.tag-warning {
  color: #ff976a;
  background: rgba(255, 151, 106, 0.12);
}

.tag-default {
  color: #969799;
  background: #f7f8fa;
}

.time {
  font-size: 24rpx;
  color: #969799;
}

.content {
  font-size: 30rpx;
  line-height: 1.7;
  color: #646566;
  margin-bottom: 48rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.actions {
  margin-top: 48rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(135deg, #1989fa 0%, #39a0ff 100%);
  border-radius: 44rpx;
  padding: 0;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.related-content {
  margin-top: 44rpx;
  padding-top: 36rpx;
  border-top: 1px solid #ebedf0;
}

.related-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 24rpx;
}

.related-info {
  background: #f7f8fa;
  padding: 28rpx;
  border-radius: 20rpx;
  border: 1px solid #eee;
}

.info-item {
  display: block;
  font-size: 26rpx;
  color: #646566;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-item--danger {
  color: #ee0a24;
}
