.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.field.col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.field.pick {
  justify-content: space-between;
}

.field.row {
  justify-content: space-between;
}

.lab {
  width: 160rpx;
  flex-shrink: 0;
  color: #646566;
}

input {
  flex: 1;
}

.ph {
  color: #323233;
}

textarea {
  width: 100%;
  min-height: 120rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 24rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 999rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn.danger {
  background: #fff;
  color: #ee0a24;
  border: 1rpx solid #ee0a24;
}
