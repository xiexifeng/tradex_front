<view class="page">
  <view wx:if="{{list.length === 0}}" class="empty">暂无收货地址</view>
  <view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="edit">
    <view class="row1">
      <text class="name">{{item.name}}</text>
      <text class="tel">{{item.tel}}</text>
      <text wx:if="{{item.isDefault}}" class="tag">默认</text>
    </view>
    <view class="addr">{{item.line}}</view>
  </view>
  <button class="add" bindtap="add">新增地址</button>
</view>
