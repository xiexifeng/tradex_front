.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  color: #969799;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.row1 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.tel {
  font-size: 28rpx;
  color: #646566;
}

.tag {
  font-size: 22rpx;
  color: #1989fa;
  border: 1rpx solid #1989fa;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.addr {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
}

.add {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 88rpx;
  line-height: 88rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 999rpx;
  border: none;
}

.add::after {
  border: none;
}
