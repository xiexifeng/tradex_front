.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.save {
  margin: 0;
  background: #1989fa !important;
  color: #fff !important;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.avatar-card {
  display: flex;
  justify-content: center;
}

.avatar-wrap {
  text-align: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f2f3f5;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #1989fa;
}

.sec {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #323233;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.field.col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.field.pick {
  justify-content: space-between;
}

.lab {
  width: 140rpx;
  flex-shrink: 0;
  color: #646566;
}

.field input {
  flex: 1;
}

.ph {
  color: #323233;
}

textarea {
  width: 100%;
  min-height: 100rpx;
  box-sizing: border-box;
}

.brief {
  min-height: 200rpx;
}
