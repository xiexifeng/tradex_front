<view class="page">
  <view class="group">
    <view class="cell" bindtap="goSecurity">
      <text class="icon">🛡</text>
      <text class="tit">账号与安全</text>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="group">
    <view class="cell" bindtap="goAddress">
      <text class="icon">📍</text>
      <text class="tit">收货地址</text>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="group">
    <view class="cell" bindtap="goHelp">
      <text class="icon">💬</text>
      <text class="tit">帮助与客服</text>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="group">
    <view class="cell" bindtap="goAbout">
      <text class="icon">ℹ</text>
      <text class="tit">关于X平台</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="bottom">
    <view class="group">
      <view class="cell" bindtap="switchAccount">
        <text class="icon">⇄</text>
        <text class="tit">切换账号</text>
        <text class="arrow">›</text>
      </view>
      <view class="cell cell--danger" bindtap="logout">
        <text class="icon">✕</text>
        <text class="tit">退出登录</text>
      </view>
    </view>
  </view>
</view>
