.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.group {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.cell {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 30rpx;
}

.cell:last-child {
  border-bottom: none;
}

.cell--danger .tit {
  color: #ee0a24;
}

.icon {
  width: 48rpx;
  margin-right: 16rpx;
  text-align: center;
}

.tit {
  flex: 1;
  color: #323233;
}

.arrow {
  color: #c8c9cc;
  font-size: 36rpx;
}

.bottom {
  margin-top: 48rpx;
}
