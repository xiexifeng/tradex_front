<view class="page">
  <view class="hero">
    <view class="hero-title">创建账号</view>
    <view class="hero-sub">完成注册后即可发布闲置、参与换物</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="lab">手机号 *</text>
      <input class="inp" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="ph" value="{{form.phone}}" data-field="phone" bindinput="onInput" bindblur="onPhoneBlur" />
    </view>
    <view wx:if="{{phoneError}}" class="err">{{phoneError}}</view>
    <view class="divider"></view>

    <view class="field field-row">
      <text class="lab">验证码 *</text>
      <input class="inp inp-flex" placeholder="验证码" placeholder-class="ph" value="{{form.verfiyCode}}" data-field="verfiyCode" bindinput="onInput" />
      <button class="code-btn" hover-class="code-btn--hover" disabled="{{countdown > 0}}" bindtap="onSendCode">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</button>
    </view>
    <view class="divider"></view>

    <view class="field">
      <text class="lab">昵称</text>
      <input class="inp" placeholder="选填" placeholder-class="ph" value="{{form.nickName}}" data-field="nickName" bindinput="onInput" />
    </view>
    <view class="divider"></view>

    <view class="field">
      <text class="lab">密码 *</text>
      <input class="inp" password="{{pwdHidden}}" placeholder="不少于6位" placeholder-class="ph" value="{{form.password}}" data-field="password" bindinput="onInput" />
      <text class="eye" bindtap="togglePwd">{{pwdHidden ? '显示' : '隐藏'}}</text>
    </view>
    <view class="divider"></view>

    <view class="field">
      <text class="lab">确认密码 *</text>
      <input class="inp" password="{{pwd2Hidden}}" placeholder="再次输入" placeholder-class="ph" value="{{form.confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
      <text class="eye" bindtap="togglePwd2">{{pwd2Hidden ? '显示' : '隐藏'}}</text>
    </view>
    <view class="divider"></view>

    <picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="field field-tap">
        <text class="lab">性别</text>
        <text class="val">{{form.gender === '1' ? '男' : form.gender === '2' ? '女' : '选填'}}</text>
        <text class="chev">›</text>
      </view>
    </picker>
    <view class="divider"></view>

    <picker mode="date" value="{{form.birthday}}" start="1900-01-01" end="{{today}}" bindchange="onBirthdayChange">
      <view class="field field-tap">
        <text class="lab">出生日期</text>
        <text class="val {{!form.birthday ? 'val--ph' : ''}}">{{form.birthday || '选填'}}</text>
        <text class="chev">›</text>
      </view>
    </picker>
    <view class="divider"></view>

    <view class="field">
      <text class="lab">头像URL</text>
      <input class="inp" placeholder="选填" placeholder-class="ph" value="{{form.avatarUrl}}" data-field="avatarUrl" bindinput="onInput" />
    </view>
    <view class="divider"></view>

    <view class="field">
      <text class="lab">邮箱</text>
      <input class="inp" placeholder="选填" placeholder-class="ph" value="{{form.email}}" data-field="email" bindinput="onInput" />
    </view>
    <view class="divider"></view>

    <view class="field field-col">
      <text class="lab lab-top">简介</text>
      <textarea class="ta" placeholder="选填" placeholder-class="ph" value="{{form.brief}}" data-field="brief" bindinput="onInput" />
    </view>
  </view>

  <button class="btn" loading="{{submitting}}" bindtap="onSubmit">注册</button>
</view>
