/* 与 RegisterView.vue（Vant inset 表单）对齐：白卡片 + 主按钮，风格贴近 login */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(165deg, #e8f1fc 0%, #f0f4f8 36%, #f5f6f8 100%);
}

.hero {
  margin-bottom: 36rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1d21;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #868b94;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx 28rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 12rpx 48rpx rgba(25, 55, 100, 0.06);
}

.field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  font-size: 28rpx;
}

.field-col {
  flex-direction: column;
  align-items: stretch;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  min-height: auto;
}

.field-row {
  flex-wrap: nowrap;
}

.field-tap {
  justify-content: space-between;
}

.lab {
  width: 168rpx;
  flex-shrink: 0;
  color: #646566;
  font-size: 28rpx;
}

.lab-top {
  width: auto;
  margin-bottom: 12rpx;
}

.inp {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  line-height: 100rpx;
  color: #323233;
  font-size: 28rpx;
}

.inp-flex {
  flex: 1;
  min-width: 0;
}

.ph {
  color: #b4b8c0;
}

.val {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #323233;
  padding-right: 8rpx;
}

.val--ph {
  color: #b4b8c0;
}

.chev {
  color: #c8c9cc;
  font-size: 36rpx;
  font-weight: 300;
}

.divider {
  height: 1rpx;
  margin-left: 168rpx;
  background: #ebedf0;
}

.code-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 8rpx 0 16rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1989fa;
  background: transparent;
  border: none;
}

.code-btn::after {
  border: none;
}

.code-btn[disabled] {
  color: #c0c4cc;
}

.code-btn--hover {
  opacity: 0.75;
}

.eye {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #1989fa;
  font-weight: 500;
  padding: 12rpx 0 12rpx 12rpx;
}

.err {
  font-size: 24rpx;
  color: #ee0a24;
  padding: 8rpx 0 8rpx 168rpx;
  margin-top: -8rpx;
}

.ta {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #323233;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  background: linear-gradient(135deg, #1989fa 0%, #3d9eff 50%, #5eb0ff 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(25, 137, 250, 0.32);
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.92;
}
