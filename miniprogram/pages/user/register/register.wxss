.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
  margin-bottom: 32rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.field.col {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.field.pick {
  justify-content: space-between;
}

.row-code {
  align-items: center;
}

.lab {
  width: 200rpx;
  flex-shrink: 0;
  color: #323233;
}

.inp-flex {
  flex: 1;
  min-width: 0;
}

.mini {
  margin: 0;
  flex-shrink: 0;
}

.ph {
  color: #646566;
}

.eye {
  font-size: 24rpx;
  color: #1989fa;
  padding: 8rpx;
}

.err {
  font-size: 24rpx;
  color: #ee0a24;
  padding: 8rpx 0 0;
}

textarea {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
}

.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1989fa;
  color: #fff;
  font-size: 32rpx;
  border-radius: 999rpx;
  border: none;
}

.btn::after {
  border: none;
}
