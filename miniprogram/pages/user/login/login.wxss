.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eaf2ff 0%, #f7f8fa 520rpx);
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #323233;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #646566;
  border-radius: 12rpx;
}

.tab--on {
  color: #1989fa;
  font-weight: 600;
  background: #ecf5ff;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.field:last-child {
  border-bottom: none;
}

.icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.field input {
  flex: 1;
  min-width: 0;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.eye {
  font-size: 24rpx;
  color: #1989fa;
  padding: 8rpx;
}

.code-btn {
  margin: 0;
  flex-shrink: 0;
}

.forgot-row {
  text-align: right;
  margin-bottom: 24rpx;
}

.muted {
  font-size: 24rpx;
  color: #969799;
}

.btn-main {
  width: 100%;
  margin: 0 0 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(90deg, #1989fa, #39a0ff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
}

.btn-main::after {
  border: none;
}

.agree {
  font-size: 22rpx;
  color: #969799;
  line-height: 1.6;
  text-align: center;
  padding: 0 16rpx;
}

.link {
  color: #1989fa;
}

.links {
  text-align: center;
  margin-top: 24rpx;
  font-size: 26rpx;
}
