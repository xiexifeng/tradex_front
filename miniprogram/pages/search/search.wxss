.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 32rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f6fa;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #1989fa;
  flex-shrink: 0;
}

.cancel {
  font-size: 28rpx;
  color: #646566;
  flex-shrink: 0;
}

.section {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.section-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-tit {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.clear {
  font-size: 26rpx;
  color: #969799;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #ecf5ff;
  color: #1989fa;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.tag--hot {
  background: #fff1f0;
  color: #ee0a24;
}

.filter-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 12rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.filter-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #323233;
  padding: 12rpx 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 0 24rpx 24rpx;
}

.empty,
.hint,
.end {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 28rpx;
  color: #969799;
}
