.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 24rpx;
}

.para {
  display: block;
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
