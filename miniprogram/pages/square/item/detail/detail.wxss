.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eaf2ff 0%, #f7f8fa 520rpx);
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.state {
  padding: 120rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #969799;
}

.header-wrap {
  position: relative;
  height: 720rpx;
  background: #000;
}

.item-swiper {
  width: 100%;
  height: 720rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
  display: block;
}

.swiper-badge {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 2;
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.share-fab {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  z-index: 2;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(25, 137, 250, 0.9);
  border-radius: 999rpx;
  border: none;
}

.share-fab::after {
  border: none;
}

.content {
  padding: 24rpx 24rpx 32rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.price-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.price-main {
  flex: 1;
  min-width: 0;
}

.currency {
  font-size: 36rpx;
  color: #ee0a24;
  font-weight: 600;
}

.amount {
  font-size: 56rpx;
  font-weight: 700;
  color: #ee0a24;
}

.unit {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #ff976a;
}

.exchange-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.exchange-label {
  font-size: 24rpx;
  color: #969799;
}

.exchange-target {
  font-size: 32rpx;
  color: #323233;
  font-weight: 600;
}

.trade-tag {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: #ecf5ff;
  color: #1989fa;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.flow-hd {
  margin-bottom: 24rpx;
}

.flow-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.flow-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.flow-step {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.flow-step:last-child {
  margin-bottom: 0;
}

.flow-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #1989fa;
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  flex-shrink: 0;
}

.flow-txt {
  flex: 1;
  min-width: 0;
}

.flow-step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.flow-step-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.45;
}

.info-card .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #323233;
  line-height: 1.35;
  margin-bottom: 16rpx;
}

.bc-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #646566;
  margin-bottom: 16rpx;
}

.bc-row--sm {
  margin-bottom: 0;
  margin-top: 8rpx;
}

.bc-label {
  margin-right: 8rpx;
}

.bc-val {
  color: #323233;
}

.bc-copy {
  margin-left: 12rpx;
  color: #1989fa;
  font-size: 24rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.tag--p {
  background: #ecf5ff;
  color: #1989fa;
}

.tag--s {
  background: #e8f9e8;
  color: #07c160;
}

.tag--w {
  background: #fff7e6;
  color: #ff976a;
}

.stats {
  display: flex;
  justify-content: space-between;
  padding-top: 8rpx;
  border-top: 1rpx solid #ebedf0;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.stat-lab {
  font-size: 22rpx;
  color: #969799;
}

.seller-card .seller-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f3f5;
}

.seller-meta {
  flex: 1;
  min-width: 0;
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.seller-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.badge {
  font-size: 22rpx;
  color: #1989fa;
  border: 1rpx solid #1989fa;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.score-row {
  margin-top: 8rpx;
}

.score-txt {
  font-size: 26rpx;
  color: #ffd21e;
}

.contact-btn {
  width: 100%;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #1989fa;
  background: #fff;
  border: 1rpx solid #1989fa;
  border-radius: 999rpx;
}

.contact-btn::after {
  border: none;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.desc-body {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  white-space: pre-wrap;
}

.grid-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.grid-row:last-child {
  border-bottom: none;
}

.grid-row .lab {
  width: 180rpx;
  flex-shrink: 0;
  color: #969799;
}

.grid-row .val {
  flex: 1;
  color: #323233;
  word-break: break-all;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.safe-bottom {
  /* alias for clarity */
}

.bar-left {
  display: flex;
  gap: 32rpx;
}

.act {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #646566;
}

.act-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #c8c9cc;
  margin-bottom: 4rpx;
}

.act-icon--on {
  color: #ee0a24;
}

.act:nth-child(2) .act-icon--on {
  color: #ffd21e;
}

.cta {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(90deg, #1989fa, #39a0ff);
  border-radius: 999rpx;
  border: none;
}

.cta::after {
  border: none;
}

.cta[disabled] {
  opacity: 0.5;
}

.popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  justify-content: center;
}

.popup-mask--bottom {
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 65vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet--tall {
  max-height: 75vh;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.sheet-x {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 48rpx;
  color: #c8c9cc;
  padding: 0 16rpx;
  line-height: 1;
}

.sheet-body {
  max-height: 42vh;
  margin-bottom: 24rpx;
}

.sheet--tall .sheet-body {
  max-height: 52vh;
}

.field {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  font-size: 28rpx;
}

.field--area {
  flex-direction: column;
  gap: 12rpx;
}

.flab {
  width: 180rpx;
  flex-shrink: 0;
  color: #646566;
  line-height: 72rpx;
}

.field input {
  flex: 1;
  min-height: 72rpx;
  line-height: 72rpx;
}

.field textarea {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
}

.fake-field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ebedf0;
}

.fake-field .fph {
  flex: 1;
  text-align: right;
  color: #323233;
}

.hint {
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #ee0a24;
}

.sheet-submit {
  width: 100%;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: #1989fa;
  border-radius: 999rpx;
  border: none;
}

.sheet-submit::after {
  border: none;
}
