/* AboutPlatformView（rpx） */
.about-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  padding: 32rpx;
}

.brand {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(to right, #1989fa, #0066ff);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #777;
}

.group {
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.group-head {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  border-bottom: 1px solid #f5f5f5;
}

.group-head-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
}

.paragraph {
  padding: 24rpx 32rpx 32rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 44rpx;
}

.group .paragraph + .paragraph {
  padding-top: 0;
}

.paragraph .list-row {
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.highlight-inline {
  display: block;
  background: #fffbe6;
  border: 1px solid #ffe58f;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #d48806;
  line-height: 40rpx;
  margin-top: 16rpx;
}

.cell-plain {
  padding: 24rpx 32rpx;
  border-top: 1px solid #f5f5f5;
}

.cell-plain--first {
  border-top: none;
}

.cell-plain-title {
  font-size: 30rpx;
  color: #323233;
}

.cell-plain-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 34rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-top: 1px solid #f5f5f5;
}

.cell:active {
  background: #f2f3f5;
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-title {
  font-size: 30rpx;
  color: #323233;
}

.cell-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.cell-value {
  font-size: 28rpx;
  color: #969799;
  margin-left: 24rpx;
  max-width: 360rpx;
  text-align: right;
  word-break: break-all;
}

.cell-arrow {
  margin-left: 16rpx;
  color: #c8c9cc;
}

.footer {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 32rpx 0 16rpx;
}

.version {
  margin-top: 8rpx;
  font-size: 22rpx;
}
