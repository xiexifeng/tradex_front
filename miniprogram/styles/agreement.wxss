/* 与 Vue agreement 视图样式一致（px→rpx，375 设计稿约 2x） */
.agreement-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  padding: 32rpx 32rpx 64rpx;
}

.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.meta {
  font-size: 24rpx;
  color: #666;
  line-height: 36rpx;
}

.divider {
  height: 1px;
  background: #ebedf0;
  margin: 24rpx 0;
}

.section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f0f0f0;
}

.paragraph {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 44rpx;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.list {
  margin: 0 0 24rpx;
}

.list-row {
  font-size: 28rpx;
  color: #555;
  line-height: 44rpx;
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.highlight {
  background: #fffbe6;
  border: 1px solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 0;
  font-size: 28rpx;
  color: #d48806;
  line-height: 40rpx;
}

.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 36rpx;
}
