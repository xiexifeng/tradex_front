/* HelpView / 折叠与通用区块（rpx） */
.help-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  padding: 32rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  line-height: 40rpx;
}

.group {
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.group-head {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  border-bottom: 1px solid #f5f5f5;
}

.group-head-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
}

.group-head-ico {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: rgba(25, 137, 250, 0.12);
  color: #1989fa;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.collapse {
  margin: 0 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.collapse-item {
  border-bottom: 1px solid #ebedf0;
}

.collapse-item:last-child {
  border-bottom: none;
}

.collapse-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #323233;
  background: #fff;
}

.collapse-hd:active {
  background: #f2f3f5;
}

.collapse-arrow {
  font-size: 24rpx;
  color: #969799;
  transform: rotate(0deg);
  transition: transform 0.2s;
}

.collapse-arrow--open {
  transform: rotate(180deg);
}

.collapse-bd {
  padding: 32rpx;
  background: #fafafa;
  border-top: 1px solid #ebedf0;
}

.collapse-bd--hidden {
  display: none;
}

.collapse-content .para {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 44rpx;
}

.collapse-content .para:last-child {
  margin-bottom: 0;
}

.collapse-content .tip {
  font-size: 26rpx;
  color: #999;
  line-height: 40rpx;
  margin-top: 16rpx;
}

.collapse-content .list-row {
  font-size: 28rpx;
  color: #555;
  line-height: 44rpx;
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.collapse-content .highlight {
  background: #fffbe6;
  border: 1px solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 0 0;
  font-size: 28rpx;
  color: #d48806;
  line-height: 40rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #fff;
  border-top: 1px solid #f5f5f5;
}

.cell--column {
  flex-direction: column;
  align-items: stretch;
}

.cell--link:active {
  background: #f2f3f5;
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-title {
  font-size: 30rpx;
  color: #323233;
}

.cell-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 34rpx;
}

.cell-value {
  font-size: 28rpx;
  color: #969799;
  margin-left: 24rpx;
}

.cell-arrow {
  margin-left: 16rpx;
  color: #c8c9cc;
  font-size: 28rpx;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 36rpx;
}
