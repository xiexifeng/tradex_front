.item-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #f2f3f5;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  background: #fff;
}

.image-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
}

.cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.tags {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pill {
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
}

.pill-blue {
  background: linear-gradient(135deg, #4da1ff, #0e73ff);
}

.pill-orange {
  background: linear-gradient(135deg, #ffb36b, #ff6a3d);
}

.info {
  padding: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 800;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12rpx 0 20rpx;
}

.price {
  font-size: 32rpx;
  font-weight: 800;
  color: #ee0a24;
}

.exchange {
  font-size: 28rpx;
  color: #1989fa;
}

.trade-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1px solid #ebedf0;
}

.trade-tag--danger {
  color: #ee0a24;
  border-color: #ee0a24;
}

.trade-tag--warning {
  color: #ff976a;
  border-color: #ff976a;
}

.trade-tag--primary {
  color: #1989fa;
  border-color: #1989fa;
}

.trade-tag--default {
  color: #969799;
}

.footer {
  padding-top: 16rpx;
  border-top: 1px solid #f5f5f5;
}

.user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.name {
  font-size: 26rpx;
  font-weight: 600;
  color: #3c3c3c;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: #f7f8fa;
  border: 1px solid #f0f1f3;
}
