<view class="publish">
  <!-- 顶部说明 -->
  <view class="notice-card">
    <view class="notice-content">
      <text class="notice-icon">ℹ️</text>
      <text class="notice-text">
        平台仅提供信息撮合服务，所有交易均为线下进行，请选择安全的交易地点。
      </text>
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="card">
    <view class="section-title">
      <text class="icon">🖼️</text>
      <text>物品图片</text>
      <text class="subtitle">（最多5张）</text>
    </view>
    <view class="uploader-wrapper">
      <view class="uploader-grid">
        <block wx:for="{{formData.images}}" wx:key="url">
          <view class="uploader-item">
            <image class="uploader-image" src="{{item.url}}" mode="aspectFill" />
            <view class="uploader-remove" data-index="{{index}}" bindtap="onRemoveImage">×</view>
          </view>
        </block>
        <view
          wx:if="{{formData.images.length < 5}}"
          class="uploader-add"
          bindtap="onChooseImage"
        >
          <text class="add-icon">＋</text>
          <text class="add-text">上传图片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="section-title">
      <text class="icon">📋</text>
      <text>基本信息</text>
    </view>

    <view class="form-group">
      <view class="form-item">
        <text class="label">物品名称</text>
        <input
          class="input"
          type="text"
          placeholder="请输入物品名称(1-50字)"
          value="{{formData.name}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-item" bindtap="onShowTypePicker">
        <text class="label">物品类型</text>
        <view class="picker-value {{formData.clazzText ? '' : 'placeholder'}}">
          <text>{{formData.clazzText || '请选择物品类型'}}</text>
        </view>
      </view>

      <view class="form-item form-textarea">
        <text class="label">物品描述</text>
        <textarea
          class="textarea"
          placeholder="请描述物品的详细信息(1-200字)"
          value="{{formData.description}}"
          bindinput="onDescInput"
          maxlength="200"
        ></textarea>
      </view>

      <view class="form-item">
        <text class="label">折旧程度</text>
        <view class="depreciation-row">
          <slider
            class="slider"
            min="1"
            max="10"
            step="1"
            value="{{formData.depreciation}}"
            activeColor="#07c160"
            bindchange="onDepChange"
          />
          <text class="depreciation-text">{{formData.depreciation}}成新</text>
        </view>
      </view>

      <view class="form-item">
        <text class="label">价值（元）</text>
        <input
          class="input"
          type="digit"
          placeholder="请填写物品残余估值0-999999"
          value="{{formData.valuation}}"
          bindinput="onValuationInput"
        />
      </view>
    </view>
  </view>

  <!-- 底部发布按钮 -->
  <view class="bottom-bar">
    <button class="primary-button" bindtap="onSubmit">发布</button>
  </view>

  <!-- 物品类型选择器 -->
  <view wx:if="{{showTypePicker}}" class="picker-mask" bindtap="onHideTypePicker">
    <view class="picker-panel" catchtap="noop">
      <view class="picker-header">
        <text class="picker-btn" bindtap="onHideTypePicker">取消</text>
        <text class="picker-title">选择物品类型</text>
        <text class="picker-btn primary" bindtap="onConfirmType">确定</text>
      </view>
      <picker-view
        class="picker-view"
        indicator-style="height: 40px;"
        value="{{[pickerIndex]}}"
        bindchange="onTypeChange"
      >
        <picker-view-column>
          <block wx:for="{{itemTypeOptions}}" wx:key="value">
            <view class="picker-item">{{item.text}}</view>
          </block>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>

