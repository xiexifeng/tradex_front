.page-container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 160rpx;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.section-card {
  margin-bottom: 24rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 24rpx;
}

.status-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.status-badge.success {
  background: #e8fff3;
  color: #07c160;
}
.status-badge.warning {
  background: #fff7e8;
  color: #ff976a;
}
.status-badge.danger {
  background: #fef0f0;
  color: #ee0a24;
}
.status-badge.primary {
  background: #eaf2ff;
  color: #1989fa;
}
.status-badge.default {
  background: #f7f8fa;
  color: #969799;
}

.item-id {
  font-size: 26rpx;
  color: #969799;
  text-align: right;
  flex: 1;
}

.section-title {
  padding: 18rpx 24rpx 12rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #323233;
}

.blockchain-info {
  padding: 0 24rpx 18rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 0;
}

.info-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #969799;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #323233;
  word-break: break-all;
}

.copy-action {
  font-size: 26rpx;
  color: #1989fa;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dbeafe;
}

.description {
  padding: 0 24rpx 22rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-word;
}

.trade-info {
  padding: 0 24rpx 18rpx;
}

.stats-row {
  padding: 0 24rpx 18rpx;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-icon {
  font-size: 30rpx;
}

.stat-value {
  font-size: 28rpx;
  color: #323233;
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  z-index: 999;
}

.bottom-btn-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bottom-btn {
  height: 90rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.bottom-btn-primary {
  background: linear-gradient(to right, #1989fa, #39a0ff);
  color: #fff;
  border: none;
}

.bottom-btn-plain {
  background: #ffffff;
  color: #1989fa;
  border: 1rpx solid #1989fa;
}

