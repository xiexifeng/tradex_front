page {
  background: linear-gradient(180deg, #eaf2ff 0%, #f7f8fa 440rpx);
}

.page-container {
  min-height: 100vh;
  /* 预留底部导航的高度，避免内容被遮挡 */
  padding-bottom: 180rpx;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #1989fa, #0066ff);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.nav-right {
  display: flex;
  align-items: center;
}

.nav-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.login-text {
  font-size: 26rpx;
  color: #ffffff;
}

.search-wrapper {
  padding: 16rpx 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background-color: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #969799;
}

.hero-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 8rpx;
  color: #323233;
}

.hero-text {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #707070;
}

.hero-notice {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #969799;
  background: #f5f7fa;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.hero-button {
  border: none;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9f43, #ff6b6b);
}

.banner-wrapper {
  padding: 0 24rpx;
  margin: 24rpx 0;
}

.banner {
  height: 300rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
}

.banner-item image {
  width: 100%;
  height: 100%;
}

.feature-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-column-gap: 20rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-text {
  font-size: 40rpx;
  color: #ffffff;
}

.feature-text {
  font-size: 24rpx;
  color: #323233;
  margin-top: 8rpx;
}

.products-section {
  margin-top: 8rpx;
}

.filter-bar {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1px solid #f5f5f5;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #646566;
}

.products-grid {
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-column-gap: 24rpx;
  grid-row-gap: 24rpx;
}

.empty-state {
  padding: 72rpx 32rpx 48rpx;
  text-align: center;
  color: #646566;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.empty-button {
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1989fa, #39a0ff);
}
