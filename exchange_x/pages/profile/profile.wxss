.profile-page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background-color: #f8f9fa;
  box-sizing: border-box;
}

.profile-content {
  padding: 24rpx;
}

.quick-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #1989fa;
}

.qa-dot {
  color: #c8c9cc;
}

.qa-link {
  padding: 8rpx 12rpx;
}

/* 用户卡片 */
.user-hero-card {
  padding: 28rpx !important;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #f8fbff 0%, #ffffff 100%) !important;
  border: 1px solid #e8f3ff;
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.hero-left {
  display: flex;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(25, 137, 250, 0.15);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f3ff;
  font-size: 56rpx;
}

.user-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #1989fa, #39a0ff);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border: 4rpx solid #ffffff;
}

.user-info-compact {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}

.gender-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.gender-tag.male {
  background: #e8f3ff;
  color: #1989fa;
}

.gender-tag.female {
  background: #ffd8e6;
  color: #ff2c7d;
}

.user-id-compact {
  font-size: 24rpx;
  color: #969799;
}

.edit-btn {
  flex-shrink: 0;
  margin: 0;
  font-size: 24rpx !important;
  color: #1989fa !important;
  border-color: #1989fa !important;
}

.core-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.core-stat-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1px solid #f0f0f0;
}

.core-stat-item.highlight {
  background: linear-gradient(135deg, #fff9e6 0%, #ffffff 100%);
  border-color: #ffe58f;
}

.core-stat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1989fa, #39a0ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.core-stat-icon.score {
  background: linear-gradient(135deg, #ffd21e, #ffb800);
}

.core-stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #323233;
  line-height: 1.2;
}

.core-stat-label {
  font-size: 22rpx;
  color: #969799;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rule-icon {
  color: #1989fa;
  font-size: 24rpx;
  padding: 4rpx 8rpx;
}

.social-stats {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1px solid #f5f5f5;
}

.social-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.social-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}

.social-label {
  font-size: 22rpx;
  color: #969799;
}

.social-divider {
  width: 1px;
  height: 48rpx;
  background: #f0f0f0;
}

.blockchain-compact {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  margin-top: 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.blockchain-text {
  flex: 1;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-hint {
  color: #1989fa;
  flex-shrink: 0;
}

/* 折叠记录 */
.records-card {
  padding: 0 !important;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.collapse-head {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid #f5f5f5;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.collapse-icon {
  margin-right: 12rpx;
}

.collapse-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #969799;
  font-weight: 400;
}

.collapse-arrow {
  margin-left: auto;
  font-size: 24rpx;
  color: #969799;
}

.collapse-body {
  padding-bottom: 8rpx;
}

.row-3 {
  display: grid;
  grid-template-columns: 100rpx 1fr 200rpx;
  align-items: center;
}

.row-3-points {
  display: grid;
  grid-template-columns: 120rpx 1fr 200rpx;
  align-items: center;
}

.table-header {
  padding: 20rpx 28rpx;
  background: #f8f9fa;
  font-size: 24rpx;
  color: #969799;
  font-weight: 600;
}

.table-row {
  padding: 20rpx 28rpx;
  font-size: 24rpx;
  color: #666666;
  border-bottom: 1px solid #f5f5f5;
}

.col-score {
  font-weight: 700;
  color: #ffd21e;
}

.col-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col-time {
  font-size: 22rpx;
  color: #969799;
  text-align: right;
}

.increase {
  color: #07c160;
  font-weight: 700;
}

.decrease {
  color: #ee0a24;
  font-weight: 700;
}

.empty-hint {
  padding: 48rpx;
  text-align: center;
  color: #969799;
  font-size: 24rpx;
}

.empty-hint.block {
  background: #ffffff;
  border-radius: 24rpx;
  margin-top: 16rpx;
}

/* 物品 tab */
.items-section {
  margin: 0 -8rpx;
}

.tab-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.tab-list {
  display: inline-flex;
  padding: 8rpx 16rpx;
  gap: 16rpx;
}

.tab-pill {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666666;
  background: #ffffff;
  border: 1px solid #ebedf0;
}

.tab-pill.active {
  color: #1989fa;
  font-weight: 600;
  border-color: #1989fa;
  background: #ecf5ff;
}

.items-list-wrap {
  min-height: 200rpx;
}

.mine-item-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1px solid #f0f0f0;
}

.mine-item-row {
  display: flex;
  gap: 24rpx;
}

.mine-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.mine-item-main {
  flex: 1;
  min-width: 0;
}

.mine-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.tag-success {
  color: #07c160;
  background: #e8f8ef;
}

.tag-warning {
  color: #ff976a;
  background: #fff5ed;
}

.tag-danger {
  color: #ee0a24;
  background: #ffe7e6;
}

.tag-default {
  color: #969799;
  background: #f7f8fa;
}

.tag-primary {
  color: #1989fa;
  background: #ecf5ff;
}

.mine-desc {
  font-size: 22rpx;
  color: #969799;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.blockchain-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bc-text {
  color: #1989fa;
  background: #f0f7ff;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bc-copy {
  color: #1989fa;
  font-size: 22rpx;
}

.mine-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-end;
}

.mini-btn {
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 0 20rpx !important;
  line-height: 52rpx !important;
  height: 52rpx !important;
}

.mini-btn.primary {
  background: linear-gradient(135deg, #1989fa, #39a0ff) !important;
  color: #ffffff !important;
}

.mini-btn.primary-plain {
  color: #1989fa !important;
  border-color: #1989fa !important;
  background: #ffffff !important;
}

.mini-btn.danger-plain {
  color: #ee0a24 !important;
  border-color: #ee0a24 !important;
  background: #ffffff !important;
}

.list-footer {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #969799;
}

.profile-empty {
  padding: 80rpx;
  text-align: center;
  color: #969799;
}

/* 积分规则弹层 */
.popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
}

.popup-mask-bottom {
  align-items: flex-end;
}

.popup-mask-center {
  align-items: center;
  justify-content: center;
}

.points-popup {
  width: 100%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid #f5f5f5;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.popup-close {
  font-size: 36rpx;
  color: #969799;
  padding: 8rpx;
}

.popup-scroll {
  flex: 1;
  max-height: 70vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.rule-section {
  margin-bottom: 32rpx;
}

.rule-h4 {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.rule-li {
  display: block;
  font-size: 26rpx;
  color: #646566;
  line-height: 44rpx;
}

.rule-p {
  font-size: 26rpx;
  color: #646566;
  line-height: 44rpx;
}

/* 取消出让 */
.cancel-dialog {
  width: 86%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.cancel-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #323233;
}

.cancel-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1px solid #ebedf0;
  border-radius: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.cancel-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.cancel-btn,
.confirm-btn {
  margin: 0 !important;
  font-size: 28rpx !important;
}
