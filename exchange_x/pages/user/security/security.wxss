.security-page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 40rpx;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.section-card {
  margin-bottom: 24rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
}

.clickable {
  cursor: pointer;
}

.cell-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  flex: 1;
}

.cell-value {
  font-size: 26rpx;
  color: #969799;
  text-align: right;
  flex: 1;
}

.cell-arrow {
  width: 60rpx;
  text-align: right;
  color: #969799;
  font-size: 30rpx;
}

.delete-cell .cell-title,
.delete-cell .cell-arrow {
  color: #ee0a24;
}

/* 弹窗 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.dialog {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ebedf0;
  margin-bottom: 16rpx;
}

.form {
  padding-bottom: 10rpx;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.input-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #323233;
  font-weight: 600;
}

.input {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e5e5;
  background-color: #ffffff;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.confirm-btn {
  margin-top: 12rpx;
  height: 96rpx;
  border-radius: 999rpx;
}

