.edit-page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: linear-gradient(to right, #1989fa, #39a0ff);
  color: #ffffff;
}

.header-left {
  font-size: 26rpx;
  width: 180rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.header-save {
  width: 180rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 999rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.section-card {
  margin-bottom: 24rpx;
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.avatar-text-main {
  font-size: 26rpx;
  color: #323233;
  font-weight: 600;
}

.avatar-text-sub {
  font-size: 22rpx;
  color: #969799;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.label {
  width: 180rpx;
  font-size: 26rpx;
  color: #323233;
  font-weight: 500;
}

.field {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1px solid #e5e5e5;
  background-color: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-row .picker-field {
  flex: 1;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1px solid #e5e5e5;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.textarea {
  flex: 1;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  border: 1px solid #e5e5e5;
  background-color: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
}

