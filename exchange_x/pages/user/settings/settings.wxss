.settings-page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 180rpx;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.section-card {
  margin-bottom: 24rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
}

.cell.clickable {
  cursor: pointer;
}

.cell-icon {
  width: 72rpx;
  font-size: 32rpx;
  text-align: center;
  color: #1989fa;
}

.cell-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.cell-arrow {
  width: 60rpx;
  text-align: right;
  color: #969799;
  font-size: 30rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-card {
  overflow: hidden;
}

.bottom-cell {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  box-sizing: border-box;
}

.divider {
  height: 1px;
  background-color: #f2f3f5;
}

.logout-cell .cell-icon,
.logout-cell .cell-title {
  color: #ee0a24;
}
