.login-container {
  min-height: 100vh;
  padding: 32rpx 32rpx 200rpx;
  background: linear-gradient(180deg, #eaf2ff 0%, #f7f8fa 520rpx);
  box-sizing: border-box;
}

.hero-section {
  margin-bottom: 32rpx;
}

.hero-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #323233;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #666666;
}

.tabs {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.tab-header {
  display: flex;
  border-bottom: 1px solid #f5f5f5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666666;
}

.tab-item.active {
  color: #1989fa;
  font-weight: 600;
  border-bottom: 4rpx solid #1989fa;
}

.tab-body {
  padding: 32rpx 32rpx 40rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  padding: 24rpx 28rpx;
  border-radius: 999rpx;
  border: 1px solid #e5e5e5;
  font-size: 28rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.code-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 验证码行内，输入框占满剩余空间，按钮自适应宽度 */
.code-group .input {
  flex: 1;
  width: auto;
}

.code-button {
  white-space: nowrap;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1989fa, #0066ff);
  color: #ffffff;
  font-size: 24rpx;
  border: none;
  min-height: 80rpx;
}

.code-button[disabled] {
  opacity: 0.6;
}

.primary-button {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1989fa, #0066ff);
  color: #ffffff;
  font-size: 30rpx;
  border: none;
  min-height: 88rpx;
}

.forgot-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}

.forgot-link {
  font-size: 22rpx;
  color: #1989fa;
}

.agreement-entry {
  margin-top: 32rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  color: #666666;
}

.agreement-entry .link {
  color: #1989fa;
}

