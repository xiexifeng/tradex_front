.page-container {
  min-height: 100vh;
  background: #f6f7fb;
  padding-bottom: 140rpx;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.section-card {
  margin-bottom: 24rpx;
}

.price-row {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.currency {
  font-size: 28rpx;
  color: #ee0a24;
  font-weight: 800;
}

.amount {
  font-size: 46rpx;
  color: #ee0a24;
  font-weight: 900;
}

.unit {
  font-size: 26rpx;
  color: #ee0a24;
  font-weight: 700;
}

.exchange-info .exchange-label {
  font-size: 26rpx;
  color: #969799;
  margin-right: 12rpx;
}

.exchange-target {
  font-size: 30rpx;
  color: #1989fa;
  font-weight: 800;
}

.trade-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  border: 1rpx solid #dbeafe;
  color: #1989fa;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
}

.seller-card {
  margin-bottom: 24rpx;
}

.seller-main {
  padding: 22rpx 24rpx;
  display: flex;
  gap: 16rpx;
}

.seller-avatar {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.seller-avatar-img {
  width: 88rpx;
  height: 88rpx;
}

.seller-avatar-placeholder {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #f7f8fa;
  border-radius: 50%;
}

.seller-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #1989fa;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
}

.seller-info {
  flex: 1;
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.seller-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #323233;
}

.cert-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  border: 1rpx solid #dbeafe;
  color: #1989fa;
  font-size: 24rpx;
  font-weight: 700;
}

.seller-score {
  font-size: 26rpx;
  color: #ffd21e;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.seller-bc {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.bc-label {
  font-size: 24rpx;
  color: #969799;
}
.bc-value {
  font-size: 24rpx;
  color: #1989fa;
  font-weight: 800;
}
.bc-copy {
  font-size: 24rpx;
  color: #1989fa;
  border: 1rpx solid #dbeafe;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

.contact-btn {
  width: calc(100% - 48rpx);
  margin: 0 auto 22rpx;
  height: 84rpx;
  border-radius: 999rpx;
}

.section-title {
  padding: 18rpx 24rpx 12rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #323233;
}

.description-content {
  padding: 0 24rpx 22rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-word;
}

.trade-grid {
  padding: 0 24rpx 18rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.trade-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 12rpx 0;
}

.item-label {
  font-size: 24rpx;
  color: #969799;
}

.item-value {
  font-size: 26rpx;
  color: #323233;
  word-break: break-word;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  z-index: 999;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.actions-group {
  display: flex;
  gap: 20rpx;
}

.action-item {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.action-icon {
  font-size: 28rpx;
  color: #666;
  font-weight: 800;
}

.action-count {
  font-size: 26rpx;
  color: #1989fa;
  font-weight: 800;
}

.primary-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #ff6034, #ee0a24);
  color: #fff;
  border: none;
  font-size: 32rpx;
  font-weight: 900;
}

